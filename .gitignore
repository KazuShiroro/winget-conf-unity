# OS・エディター
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/*
!.vscode/extensions.json

# ローカル専用・一時ファイル
*.local*
.tmp/
/results/

# .NET（tools/util）
bin/
obj/

# Husky.Net が install 時に生成する
.husky/_/

# Unity の標準的な除外は Unity.Client/.gitignore（github/gitignore の Unity.gitignore を原文のまま）に置く。
# 以下はこのリポジトリ固有のもの。
# Unity の IDE パッケージが生成する個人設定。
/Unity.Client/.vscode/
# Unity が生成する難読化された Package Manager の設定。内容を検証できないため公開リポジトリに含めない。
/Unity.Client/ProjectSettings/PackageManager.policy
